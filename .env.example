# ── Blockchain ──────────────────────────────────────────────────────────────────
# Polygon Amoy RPC URL (get a free key from Alchemy or Infura for production use)
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Deployer wallet private key — NEVER commit this value, keep in .env only
DEPLOYER_PRIVATE_KEY=

# Polygonscan API key (for contract verification)
POLYGONSCAN_API_KEY=

# Contract address — filled in after deployment
VITE_CONTRACT_ADDRESS=

# ── Supabase ─────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Service role key — server-side only, never expose to frontend
SUPABASE_SERVICE_ROLE_KEY=

# ── Frontend ─────────────────────────────────────────────────────────────────────
# Public RPC URL (can be the same as AMOY_RPC_URL)
VITE_AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Vercel deployment URL (filled after Phase 8)
VITE_APP_URL=
